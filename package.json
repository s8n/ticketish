		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.0.8"
	},
	"dependencies": {
		"@fontsource/barlow": "^5.3.0",
		"@fontsource/barlow-condensed": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"fflate": "^0.8.2",
		"pdfjs-dist": "^5.4.54",
		"zxing-wasm": "^2.2.0"
